# Local file database. For production, point at a Turso URL + auth token instead.
DATABASE_URL="file:./data/crementum.db"
# DATABASE_AUTH_TOKEN=""

# Email delivery. Leave RESEND_API_KEY unset and submissions are still saved —
# the notification is written to the server log instead of being sent.
RESEND_API_KEY=""
NOTIFY_EMAIL="crementumteaching@gmail.com"
NOTIFY_FROM="Crementum <onboarding@resend.dev>"

# Required by NextAuth even when no login provider is configured.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Google sign-in. Leave blank to hide it — the site runs signed-out without errors.
# Redirect URI: http://localhost:3300/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password for the admin screen. Blank disables admin login.
ADMIN_PASSWORD=""
